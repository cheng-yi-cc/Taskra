<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- 系统自动备份仅作补充：排除图片原图与数据库，避免“有库无图”的半套恢复。
             完整备份请使用应用内 设置→备份恢复 导出的压缩包。 -->
        <exclude domain="file" path="images/" />
        <exclude domain="file" path="camera/" />
        <exclude domain="database" path="taskra.db" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="images/" />
        <exclude domain="file" path="camera/" />
    </device-transfer>
</data-extraction-rules>
